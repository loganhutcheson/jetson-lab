[Unit]
Description=Panini OLED clock
After=time-sync.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /opt/panini/clock.py
Restart=on-failure
RestartSec=10
User=@USER@
SupplementaryGroups=i2c
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
