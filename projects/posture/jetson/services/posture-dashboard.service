[Unit]
Description=Posture history dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-/etc/default/posture-dashboard
ExecStart=@PROJECT_ROOT@/jetson/services/run_posture_dashboard.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
