[Unit]
Description=Always-on posture runtime
After=network-online.target nvargus-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-/etc/default/posture-runtime
ExecStart=@PROJECT_ROOT@/jetson/services/run_posture_runtime.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
